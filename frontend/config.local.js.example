// ── Local API keys — NEVER commit this file ──────────────────────────────────
// 1. Copy this file:  cp config.local.js.example config.local.js
// 2. Fill in your keys below
// 3. config.local.js is gitignored — it will never be pushed to git
//
// Keys are merged on top of the defaults in config.js.
// You only need to override the keys you actually use.

// TMDB — https://www.themoviedb.org/settings/api
CONFIG.TMDB_API_KEY = 'your_tmdb_api_key_here';

// Gemini — https://aistudio.google.com/apikey  (optional, falls back to keyword matcher)
CONFIG.GEMINI_API_KEY = 'your_gemini_api_key_here';

// Backend URL — leave empty for relative URLs (works with localhost)
// CONFIG.API_BASE_URL = 'http://localhost:5000';
